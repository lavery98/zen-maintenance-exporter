# EditorConfig is awesome: https://editorconfig.org

root = true

# Unix-style newlines with a newline ending every file
[*]
indent_style = space
indent_size = 4
trim_tailing_whitespace = true
insert_final_newline = true
end_of_line = lf
charset = utf-8

[*.{yml, yaml}]
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab
